# Copy to .env and adjust as needed
# All secrets are local-only for MVP

APP_ENV=development
DATABASE_URL=sqlite:///./afia.db
API_HOST=127.0.0.1
API_PORT=8000

# SMS mock (no external provider)
SMS_MOCK_LOG_PATH=./logs/sms_mock.log

# Synthetic data seed (for reproducibility)
SYNTHETIC_SEED=20260806
SYNTHETIC_PHARMACY_COUNT=15
